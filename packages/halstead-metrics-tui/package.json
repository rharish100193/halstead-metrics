{
    "name": "halstead-metrics-tui",
    "version": "1.3.0",
    "description": "Terminal UI for Halstead metrics in all major programming languages, with HTML and PDF reports",
    "bin": {
        "halstead-tui": "index.mjs"
    },
    "files": [
        "index.mjs",
        "ui",
        "lib"
    ],
    "scripts": {
        "start": "node index.mjs",
        "test:unit": "node --test test/unit/*.js",
        "test:integration": "node --test test/integration/*.js",
        "test": "npm run test:unit && npm run test:integration"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "halstead-metrics": "1.3.0",
        "ink": "^8.0.0",
        "react": "^19.3.0"
    },
    "author": {
        "name": "Harish Ramasubramanian",
        "email": "rharish100193@gmail.com",
        "url": "https://github.com/rharish100193"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rharish100193/halstead-metrics.git",
        "directory": "packages/halstead-metrics-tui"
    },
    "publishConfig": {
        "access": "public"
    }
}
